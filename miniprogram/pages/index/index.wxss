.page {
  min-height: 100vh;
  background: #FEFCF8;
  padding-bottom: 48rpx;
}

.nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 20;
  background: rgba(254, 252, 248, 0.96);
  border-bottom: 2rpx solid #ECE3F7;
}

.nav-inner {
  position: relative;
  height: 96rpx;
  display: flex;
  align-items: center;
  padding: 0 32rpx;
}

.brand-mark {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
  background: #3E345A;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 800;
  letter-spacing: 0;
  box-shadow: 0 8rpx 18rpx rgba(73, 58, 105, 0.18);
}

.brand-copy {
  margin-left: 18rpx;
  min-width: 0;
}

.brand-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #3E345A;
  line-height: 1.15;
}

.brand-sub {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #8F829F;
  white-space: nowrap;
}

.nav-bell {
  position: absolute;
  right: 32rpx;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #ECE4F8;
  border-radius: 50%;
  background: #FFFFFF;
}

.bell-icon {
  font-size: 28rpx;
}

.bell-dot {
  position: absolute;
  top: 10rpx;
  right: 12rpx;
  width: 12rpx;
  height: 12rpx;
  border: 3rpx solid #FFFFFF;
  border-radius: 50%;
  background: #EF7F72;
}

.body {
  padding-left: 32rpx;
  padding-right: 32rpx;
}

.search-box {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 18rpx 0 28rpx;
  background: #FFFFFF;
  border: 2rpx solid #E9E1F8;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 22rpx rgba(106, 88, 146, 0.04);
}

.search-icon {
  font-size: 28rpx;
  margin-right: 16rpx;
}

.search-placeholder {
  flex: 1;
  min-width: 0;
  color: #B4A9C6;
  font-size: 25rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.search-enter {
  flex-shrink: 0;
  height: 58rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
  background: #8B6FE8;
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 600;
}

.tag-scroll {
  margin-top: 22rpx;
  width: 100%;
  white-space: nowrap;
}

.tag-row {
  display: inline-flex;
  padding-right: 32rpx;
}

.tag {
  margin-right: 14rpx;
}

.section {
  margin-top: 52rpx;
}

.hot-section {
  margin-top: 46rpx;
}

.section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-bottom: 22rpx;
}

.section-title {
  display: flex;
  align-items: center;
  font-size: 32rpx;
  font-weight: 800;
  color: #3E345A;
}

.title-dot {
  width: 12rpx;
  height: 28rpx;
  margin-right: 14rpx;
  border-radius: 6rpx;
}

.dot-blue {
  background: #8B6FE8;
}

.dot-coral {
  background: #EF7F72;
}

.dot-green {
  background: #43B98F;
}

.section-sub {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #9C8FB1;
}

.section-more {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding-bottom: 2rpx;
  font-size: 24rpx;
  color: #8B6FE8;
  font-weight: 600;
}

.more-arrow {
  font-size: 26rpx;
}

.hot-scroll {
  width: 100%;
  white-space: nowrap;
}

.hot-row {
  display: inline-flex;
  padding-right: 24rpx;
}

.hot-card {
  width: 440rpx;
  min-height: 260rpx;
  margin-right: 20rpx;
  padding: 26rpx;
  display: inline-flex;
  flex-direction: column;
  vertical-align: top;
  border-top: 8rpx solid #8B6FE8;
}

.hot-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hot-rank {
  font-size: 26rpx;
  font-weight: 800;
  color: #DED2E9;
  letter-spacing: 1rpx;
}

.hot-tag {
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 700;
}

.hot-title {
  margin-top: 20rpx;
  font-size: 30rpx;
  font-weight: 800;
  color: #3E345A;
}

.hot-preview {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.55;
  color: #6F638A;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  white-space: normal;
}

.hot-open {
  margin-top: auto;
  padding-top: 18rpx;
  font-size: 22rpx;
  color: #8B6FE8;
  font-weight: 600;
}

.risk-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.risk-card {
  min-height: 278rpx;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  border-top: 8rpx solid #EF7F72;
}

.risk-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.risk-icon {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 26rpx;
  background: #FEFCF8;
  font-size: 28rpx;
}

.risk-badge {
  height: 42rpx;
  padding: 0 14rpx;
  display: flex;
  align-items: center;
  border-radius: 999rpx;
  background: #FFEDE9;
  color: #E77B68;
  font-size: 20rpx;
  font-weight: 800;
}

.risk-title {
  margin-top: 22rpx;
  font-size: 28rpx;
  font-weight: 800;
  color: #3E345A;
}

.risk-preview {
  margin-top: 12rpx;
  font-size: 23rpx;
  line-height: 1.55;
  color: #6F638A;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}

.risk-foot {
  margin-top: auto;
  padding-top: 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.risk-tag {
  font-size: 20rpx;
  color: #8B6FE8;
  font-weight: 700;
}

.risk-arrow {
  font-size: 28rpx;
  color: #C2B5D7;
  font-weight: 700;
}

.new-list {
  padding: 4rpx 24rpx;
}

.new-item {
  display: flex;
  align-items: center;
  min-height: 120rpx;
  padding: 22rpx 0;
  border-bottom: 2rpx solid #F1EAF8;
}

.new-item-last {
  border-bottom: none;
}

.new-index {
  width: 52rpx;
  height: 52rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
  background: #FEFCF8;
  color: #9C8FB1;
  font-size: 22rpx;
  font-weight: 800;
}

.new-main {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.new-title {
  font-size: 27rpx;
  font-weight: 700;
  color: #3E345A;
}

.new-preview {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #8F829F;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.new-tag {
  flex-shrink: 0;
  margin-left: 14rpx;
  font-size: 21rpx;
  font-weight: 700;
}

.new-arrow {
  flex-shrink: 0;
  margin-left: 10rpx;
  font-size: 26rpx;
  color: #C2B5D7;
}

.refresh-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 220rpx;
  z-index: 30;
  display: flex;
  flex-direction: column;
  align-items: center;
  pointer-events: none;
}

.refresh-img {
  width: 140rpx;
  height: 140rpx;
  animation: mascotJump 0.8s ease-in-out infinite;
}

.refresh-text {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #8B6FE8;
  background: #FFFFFF;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  box-shadow: 0 8rpx 20rpx rgba(139, 111, 232, 0.12);
}

@keyframes mascotJump {
  0%, 100% {
    transform: translateY(0) rotate(-6deg);
  }
  50% {
    transform: translateY(-24rpx) rotate(8deg);
  }
}
