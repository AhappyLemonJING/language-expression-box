.page {
  min-height: 100vh;
  padding: 28rpx 32rpx 52rpx;
  background: #FEFCF8;
}

.page-intro {
  padding: 4rpx 4rpx 28rpx;
}

.intro-title {
  font-size: 38rpx;
  font-weight: 800;
  color: #3E345A;
}

.intro-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #8F829F;
  line-height: 1.5;
}

.form-card {
  padding: 8rpx 28rpx 30rpx;
}

.field {
  padding-top: 30rpx;
}

.label {
  margin-bottom: 14rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #3E345A;
}

.required {
  color: #EF7F72;
}

.input,
.picker,
.textarea {
  width: 100%;
  border: 2rpx solid #E9E1F8;
  border-radius: 26rpx;
  background: #FBF8FE;
  color: #3E345A;
  font-size: 26rpx;
}

.input {
  height: 88rpx;
  padding: 0 24rpx;
}

.picker {
  height: 88rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.picker-empty {
  color: #B4A9C6;
}

.picker-arrow {
  color: #8B6FE8;
  font-size: 30rpx;
}

.textarea {
  min-height: 240rpx;
  padding: 22rpx 24rpx;
  line-height: 1.6;
}

.counter {
  margin-top: 10rpx;
  text-align: right;
  font-size: 22rpx;
  color: #B4A9C6;
}

.vars-hint {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.empty-vars {
  padding: 20rpx 24rpx;
  border-radius: 26rpx;
  background: #FBF8FE;
  color: #B4A9C6;
  font-size: 24rpx;
}

.var-chip {
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: #F0EAFE;
  color: #8B6FE8;
  font-size: 23rpx;
  font-weight: 700;
}

.tip-textarea {
  min-height: 150rpx;
}

.save-btn {
  margin-top: 32rpx;
}

.save-icon {
  font-size: 28rpx;
  font-weight: 800;
}
