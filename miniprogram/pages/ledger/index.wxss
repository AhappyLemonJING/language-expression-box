.page {
  min-height: 100vh;
  padding: 24rpx 0 48rpx;
  background: #FFFDF8;
}

.filter-scroll {
  width: 100%;
  white-space: nowrap;
  padding-left: 32rpx;
}

.filter-row {
  display: inline-flex;
  padding-right: 32rpx;
}

.filter-pill {
  margin-right: 16rpx;
}

.list {
  margin-top: 28rpx;
  padding: 0 32rpx;
}

.ledger-card {
  margin-bottom: 20rpx;
  padding: 28rpx;
}

.ledger-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.contact {
  font-size: 31rpx;
  font-weight: 700;
  color: #333333;
}

.status {
  padding: 6rpx 20rpx;
  border-radius: 28rpx;
  font-size: 22rpx;
  font-weight: 700;
}

.status-pending {
  background: #FFF3C9;
  color: #C39216;
}

.status-closed {
  background: #DFF6E9;
  color: #2F9E6E;
}

.status-overdue {
  background: #FFE4CE;
  color: #E0782D;
}

.phrase-title,
.send-time {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #77728A;
}

.note {
  margin-top: 16rpx;
  padding: 18rpx 22rpx;
  border-radius: 24rpx;
  background: #F8F6FF;
  color: #6F6580;
  font-size: 24rpx;
  line-height: 1.55;
}

.ledger-actions {
  margin-top: 20rpx;
  display: flex;
  gap: 16rpx;
}

.ledger-btn {
  flex: 1;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 30rpx;
  background: #F3EFFF;
  color: #6F5BD6;
  font-size: 24rpx;
  font-weight: 600;
}

.close-btn {
  background: #9B86F5;
  color: #FFFFFF;
  box-shadow: 0 8rpx 18rpx rgba(155, 134, 245, 0.24);
}

.close-mask {
  position: fixed;
  inset: 0;
  z-index: 50;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(51, 42, 72, 0.28);
}

.sparkle-card {
  position: relative;
  width: 400rpx;
  height: 360rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 44rpx;
  background: #FFFFFF;
  box-shadow: 0 20rpx 60rpx rgba(75, 58, 128, 0.25);
  animation: popIn 0.3s ease-out;
}

.spark-img {
  width: 200rpx;
  height: 200rpx;
}

.spark-title {
  margin-top: 6rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #333333;
}

.spark-star {
  position: absolute;
  font-size: 34rpx;
  color: #FFD06B;
  animation: sparkleFly 0.9s ease-out infinite;
}

.s1 {
  left: 64rpx;
  top: 72rpx;
}

.s2 {
  right: 66rpx;
  top: 118rpx;
  color: #FF9DBC;
  animation-delay: 0.15s;
}

.s3 {
  left: 108rpx;
  bottom: 72rpx;
  color: #7CD9AF;
  animation-delay: 0.3s;
}

@keyframes popIn {
  from {
    transform: scale(0.7);
    opacity: 0;
  }
  to {
    transform: scale(1);
    opacity: 1;
  }
}

@keyframes sparkleFly {
  0% {
    transform: translateY(0) scale(1);
    opacity: 1;
  }
  100% {
    transform: translateY(-30rpx) scale(1.3);
    opacity: 0;
  }
}
