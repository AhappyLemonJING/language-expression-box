.page {
  min-height: 100vh;
  padding: 28rpx 32rpx 56rpx;
  background: #FEFCF8;
}

.search-box {
  display: flex;
  align-items: center;
  height: 88rpx;
  padding: 0 20rpx 0 28rpx;
  background: #FFFFFF;
  border: 2rpx solid #E9E1F8;
  border-radius: 28rpx;
  box-shadow: 0 8rpx 22rpx rgba(106, 88, 146, 0.04);
}

.search-icon {
  font-size: 28rpx;
  margin-right: 16rpx;
}

.search-input {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: #3E345A;
}

.search-placeholder {
  color: #B4A9C6;
}

.search-clear {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #F5EEFB;
  color: #6F638A;
  font-size: 22rpx;
}

.result-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 34rpx 4rpx 22rpx;
}

.result-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #3E345A;
}

.result-count {
  font-size: 22rpx;
  color: #9C8FB1;
}

.grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.cat-card {
  position: relative;
  min-height: 232rpx;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
}

.cat-custom {
  border-style: dashed;
  border-color: #D2C2DF;
  box-shadow: none;
  background: #FFFFFF;
}

.cat-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.cat-icon-box {
  width: 76rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
}

.cat-icon {
  font-size: 40rpx;
}

.cat-arrow {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #ECE4F8;
  border-radius: 50%;
  background: #FFFFFF;
  color: #B4A9C6;
  font-size: 25rpx;
  font-weight: 700;
}

.cat-name {
  margin-top: 20rpx;
  font-size: 29rpx;
  font-weight: 800;
  color: #3E345A;
}

.cat-desc {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8F829F;
  line-height: 1.45;
}

.cat-count {
  margin-top: auto;
  padding-top: 14rpx;
  font-size: 21rpx;
  color: #8B6FE8;
  font-weight: 700;
}

.cat-custom .cat-count {
  color: #9C8FB1;
}
