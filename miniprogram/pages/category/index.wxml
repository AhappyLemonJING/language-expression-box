<view class="page">
  <view class="search-box">
    <text class="search-icon">🔍</text>
    <input
      class="search-input"
      placeholder="搜索分类或话术"
      placeholder-class="search-placeholder"
      confirm-type="search"
      bindinput="onSearchInput"
      value="{{keyword}}"
    />
    <view class="search-clear" wx:if="{{keyword}}" bindtap="onClearSearch">✕</view>
  </view>

  <view class="grid">
    <view
      wx:for="{{filteredCategories}}"
      wx:key="id"
      class="cat-card card"
      style="background: {{item.color}}; border-color: {{item.accent}};"
      data-id="{{item.id}}"
      bindtap="onCategoryTap"
    >
      <view class="cat-illustration" style="background: {{item.accent}};">
        <text class="cat-icon">{{item.icon}}</text>
      </view>
      <view class="cat-name">{{item.name}}</view>
      <view class="cat-desc">{{item.desc}}</view>
      <view class="cat-arrow" style="color: {{item.accent}};">›</view>
    </view>
  </view>

  <view class="empty-wrap" wx:if="{{!filteredCategories.length}}">
    <image class="empty-img" src="/images/huaxiaobao/empty-search.png"></image>
    <view class="empty-title">没有找到这个分类</view>
    <view class="empty-desc">换个关键词试试吧，比如：拒绝、婚礼、售后</view>
  </view>
</view>
