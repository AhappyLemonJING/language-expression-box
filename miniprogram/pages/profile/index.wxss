.page {
  min-height: 100vh;
  padding: 28rpx 32rpx 52rpx;
  background: #FEFCF8;
}

.profile-hero {
  position: relative;
  min-height: 260rpx;
  padding: 34rpx 30rpx;
  display: flex;
  align-items: center;
  overflow: hidden;
  border-radius: 32rpx;
  background: #3E345A;
  box-shadow: 0 18rpx 40rpx rgba(73, 58, 105, 0.18);
}

.hero-stripe {
  position: absolute;
  width: 220rpx;
  height: 220rpx;
  border: 28rpx solid rgba(255, 255, 255, 0.05);
  border-radius: 32rpx;
  transform: rotate(18deg);
}

.stripe-one {
  right: -70rpx;
  top: -90rpx;
}

.stripe-two {
  right: 80rpx;
  bottom: -150rpx;
  border-color: rgba(139, 111, 232, 0.22);
}

.avatar-ring {
  position: relative;
  z-index: 1;
  width: 128rpx;
  height: 128rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 32rpx;
  background: #8B6FE8;
  box-shadow: 0 14rpx 28rpx rgba(0, 0, 0, 0.2);
}

.avatar-inner {
  width: 96rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 22rpx;
  background: #FFFFFF;
  color: #3E345A;
  font-size: 44rpx;
  font-weight: 800;
}

.profile-info {
  position: relative;
  z-index: 1;
  flex: 1;
  min-width: 0;
  margin-left: 26rpx;
}

.nickname {
  font-size: 36rpx;
  font-weight: 800;
  color: #FFFFFF;
}

.profile-sub {
  margin-top: 10rpx;
  font-size: 23rpx;
  color: #B8A6CC;
  line-height: 1.45;
}

.hero-level {
  position: absolute;
  right: 28rpx;
  top: 28rpx;
  height: 44rpx;
  padding: 0 16rpx;
  display: flex;
  align-items: center;
  border: 2rpx solid rgba(255, 255, 255, 0.18);
  border-radius: 999rpx;
  color: #E2D8F0;
  font-size: 20rpx;
  font-weight: 700;
}

.section-head {
  margin: 34rpx 4rpx 20rpx;
  font-size: 28rpx;
  font-weight: 800;
  color: #3E345A;
}

.menu {
  padding: 8rpx 26rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  height: 112rpx;
  border-bottom: 2rpx solid #F1EAF8;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  width: 66rpx;
  height: 66rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
  font-size: 32rpx;
}

.menu-name {
  flex: 1;
  margin-left: 20rpx;
  font-size: 27rpx;
  color: #3E345A;
  font-weight: 700;
}

.menu-arrow {
  font-size: 28rpx;
  color: #B5A6CA;
  font-weight: 700;
}

.version {
  margin-top: 46rpx;
  text-align: center;
  font-size: 21rpx;
  color: #B4A9C6;
}
