.page {
  min-height: 100vh;
  padding: 28rpx 32rpx 170rpx;
  background: #FEFCF8;
}

.summary-row {
  display: flex;
  gap: 20rpx;
}

.summary-card {
  flex: 1;
  min-height: 120rpx;
  padding: 22rpx 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  border: 2rpx solid #ECE4F8;
  border-radius: 32rpx;
  background: #FFFFFF;
}

.summary-count {
  font-size: 40rpx;
  font-weight: 800;
  color: #3E345A;
  line-height: 1;
}

.summary-label {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #8F829F;
}

.tabs {
  display: flex;
  margin-top: 28rpx;
  padding: 8rpx;
  border-radius: 28rpx;
  background: #F0E8FA;
}

.tab {
  flex: 1;
  height: 74rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border-radius: 22rpx;
  font-size: 25rpx;
  color: #6F638A;
}

.tab-icon {
  font-size: 24rpx;
}

.tab-active {
  background: #FFFFFF;
  color: #3E345A;
  font-weight: 800;
  box-shadow: 0 6rpx 16rpx rgba(106, 88, 146, 0.08);
}

.list {
  margin-top: 28rpx;
}

.mine-card {
  margin-bottom: 20rpx;
  padding: 26rpx;
}

.mine-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.mine-title {
  flex: 1;
  min-width: 0;
  font-size: 29rpx;
  font-weight: 800;
  color: #3E345A;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.mine-scenario {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: #F0EAFE;
  color: #8B6FE8;
  font-size: 21rpx;
  font-weight: 700;
}

.mine-preview {
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #6F638A;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.mine-card-foot {
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 2rpx solid #F1EAF8;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.mine-risk,
.mine-vars {
  height: 42rpx;
  padding: 0 14rpx;
  display: flex;
  align-items: center;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 800;
}

.risk-high {
  background: #FFEDE9;
  color: #E77B68;
}

.risk-mid {
  background: #FFF3DC;
  color: #C58A22;
}

.risk-low {
  background: #E7F6EF;
  color: #39A87F;
}

.mine-vars {
  background: #F0EAFE;
  color: #8B6FE8;
  font-weight: 700;
}

.mine-vars-empty {
  background: #F5EEFB;
  color: #B4A9C6;
}

.mine-go {
  font-size: 22rpx;
  color: #8B6FE8;
  font-weight: 700;
}

.mine-del {
  height: 42rpx;
  padding: 0 16rpx;
  display: flex;
  align-items: center;
  border-radius: 999rpx;
  background: #FFEDE9;
  color: #E77B68;
  font-size: 20rpx;
  font-weight: 700;
}

.fab {
  position: fixed;
  right: 36rpx;
  bottom: 180rpx;
  width: 104rpx;
  height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 32rpx;
  background: #3E345A;
  color: #FFFFFF;
  box-shadow: 0 16rpx 30rpx rgba(73, 58, 105, 0.24);
}

.fab-plus {
  font-size: 52rpx;
  font-weight: 500;
  line-height: 1;
}
