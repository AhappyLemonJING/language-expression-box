.page {
  min-height: 100vh;
  padding: 28rpx 32rpx 56rpx;
  background: #FEFCF8;
}

.head-card {
  padding: 28rpx;
}

.contact-row {
  display: flex;
  align-items: center;
}

.contact-avatar {
  width: 76rpx;
  height: 76rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
  background: #F0EAFE;
  color: #8B6FE8;
  font-size: 30rpx;
  font-weight: 800;
}

.contact-info {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.head-contact {
  font-size: 31rpx;
  font-weight: 800;
  color: #3E345A;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.head-meta {
  margin-top: 7rpx;
  font-size: 21rpx;
  color: #B4A9C6;
}

.head-status {
  flex-shrink: 0;
  height: 42rpx;
  padding: 0 14rpx;
  display: flex;
  align-items: center;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 800;
}

.status-pending {
  background: #FFF3DC;
  color: #C58A22;
}

.status-closed {
  background: #E7F6EF;
  color: #39A87F;
}

.status-overdue {
  background: #FFEDE9;
  color: #E77B68;
}

.head-phrase {
  margin-top: 24rpx;
  padding-top: 22rpx;
  border-top: 2rpx solid #F1EAF8;
  font-size: 25rpx;
  color: #8B6FE8;
  font-weight: 700;
}

.form-card {
  margin-top: 24rpx;
  padding: 30rpx;
}

.section-title {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  font-size: 27rpx;
  font-weight: 800;
  color: #3E345A;
}

.section-hint {
  font-size: 21rpx;
  font-weight: 400;
  color: #B4A9C6;
}

.feedback-input {
  width: 100%;
  min-height: 230rpx;
  margin-top: 16rpx;
  padding: 22rpx 24rpx;
  border: 2rpx solid #E9E1F8;
  border-radius: 26rpx;
  background: #FBF8FE;
  font-size: 26rpx;
  line-height: 1.6;
  color: #3E345A;
}

.placeholder {
  color: #B5A6CA;
}

.reminder-title {
  margin-top: 30rpx;
}

.reminder-row {
  margin-top: 16rpx;
  display: flex;
  gap: 14rpx;
}

.reminder-picker {
  flex: 1;
  height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  border: 2rpx solid #E9E1F8;
  border-radius: 26rpx;
  background: #FBF8FE;
  font-size: 24rpx;
  color: #3E345A;
}

.picker-icon {
  font-size: 26rpx;
}

.actions {
  margin-top: 28rpx;
}

.btn-icon {
  font-size: 27rpx;
  font-weight: 800;
}

.close-btn {
  width: 100%;
  height: 92rpx;
  margin-top: 18rpx;
  background: #F5EEFB;
  color: #6B5D86;
}
