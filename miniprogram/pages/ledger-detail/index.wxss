.page {
  min-height: 100vh;
  padding: 24rpx 32rpx 48rpx;
  background: #FFFDF8;
}

.head-card {
  padding: 30rpx;
}

.head-contact {
  font-size: 34rpx;
  font-weight: 700;
  color: #333333;
}

.head-phrase {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: #6F5BD6;
}

.head-meta {
  margin-top: 14rpx;
  font-size: 23rpx;
  color: #888888;
}

.form-card {
  margin-top: 24rpx;
  padding: 30rpx;
}

.label {
  font-size: 26rpx;
  font-weight: 700;
  color: #4C3EA6;
}

.feedback-input {
  width: 100%;
  min-height: 220rpx;
  margin-top: 16rpx;
  padding: 24rpx;
  border-radius: 30rpx;
  background: #F8F6FF;
  border: 2rpx solid #ECE7FB;
  font-size: 27rpx;
  line-height: 1.6;
}

.placeholder {
  color: #B7B1C9;
}

.reminder-label {
  margin-top: 30rpx;
}

.reminder-row {
  margin-top: 16rpx;
  display: flex;
  gap: 16rpx;
}

.reminder-picker {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  border-radius: 30rpx;
  background: #F8F6FF;
  border: 2rpx solid #ECE7FB;
  font-size: 26rpx;
  color: #333333;
}

.picker-icon {
  font-size: 28rpx;
}

.save-btn,
.close-btn {
  margin-top: 24rpx;
  width: 100%;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 36rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.save-btn {
  background: #9B86F5;
  color: #FFFFFF;
  box-shadow: 0 14rpx 28rpx rgba(155, 134, 245, 0.3);
}

.close-btn {
  background: #DFF6E9;
  color: #2F9E6E;
}
