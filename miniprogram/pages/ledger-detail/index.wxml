<view class="page">
  <view class="head-card card" wx:if="{{record}}">
    <view class="contact-row">
      <view class="contact-avatar">{{record.initial}}</view>
      <view class="contact-info">
        <view class="head-contact">{{record.contact || '未命名对象'}}</view>
        <view class="head-meta">发送时间：{{record.time}}</view>
      </view>
      <view class="head-status status-{{record.status === '已超时' ? 'overdue' : record.status === '已闭环' ? 'closed' : 'pending'}}">{{record.status}}</view>
    </view>
    <view class="head-phrase">{{record.phraseTitle}}</view>
  </view>

  <view class="form-card card" wx:if="{{record}}">
    <view class="section-title">
      <text>对方反馈</text>
      <text class="section-hint">记录实际沟通结果</text>
    </view>
    <textarea
      class="feedback-input"
      placeholder="记录对方的回复、态度或后续约定"
      placeholder-class="placeholder"
      value="{{feedback}}"
      bindinput="onFeedbackInput"
    />

    <view class="section-title reminder-title">
      <text>下次回访提醒</text>
      <text class="section-hint">到点提醒你继续跟进</text>
    </view>
    <view class="reminder-row">
      <picker mode="date" value="{{reminderDate}}" start="{{today}}" bindchange="onDateChange">
        <view class="reminder-picker">
          <text class="picker-icon">📅</text>
          <text>{{reminderDate}}</text>
        </view>
      </picker>
      <picker mode="time" value="{{reminderTime}}" bindchange="onTimeChange">
        <view class="reminder-picker">
          <text class="picker-icon">⏰</text>
          <text>{{reminderTime}}</text>
        </view>
      </picker>
    </view>
  </view>

  <view class="actions">
    <button class="primary-btn" bindtap="onSaveTap">
      <text class="btn-icon">✓</text>
      <text>保存跟进记录</text>
    </button>
    <button class="secondary-btn close-btn" bindtap="onCloseTap">
      <text class="btn-icon">◼</text>
      <text>标记闭环</text>
    </button>
  </view>
</view>
